<idea-plugin>
	<id>com.whip.rider.tools</id>
	<name>Whip Tools Rider</name>
	<vendor>Whip Engine</vendor>

	<description><![CDATA[
		Whip Engine tooling for JetBrains Rider. The first tool reads Whip's generated
		.whip-debugger.json contract and starts a Mono soft debugger attach session.
	]]></description>

	<depends>com.intellij.modules.platform</depends>
	<depends>com.intellij.modules.rider</depends>

	<extensions defaultExtensionNs="com.intellij">
		<configurationType implementation="com.whip.rider.debugger.WhipMonoRemoteConfigurationType"/>
		<postStartupActivity implementation="com.whip.rider.debugger.WhipToolsStartupActivity"/>
		<toolWindow
			id="Whip"
			anchor="right"
			icon="/icons/whip.svg"
			factoryClass="com.whip.rider.debugger.WhipToolWindowFactory"
			canCloseContents="false"/>
	</extensions>

	<actions>
		<group id="Whip.Tools.Group" text="Whip" description="Whip Engine tools" popup="true">
			<add-to-group group-id="MainMenu" anchor="last"/>
			<add-to-group group-id="ToolsMenu" anchor="last"/>
			<action
				id="Whip.Tools.AttachToDebugger"
				class="com.whip.rider.debugger.AttachToWhipDebuggerAction"
				text="Attach to Whip Debugger"
				description="Read .whip-debugger.json and attach Rider to Whip's Mono debugger"/>
		</group>
	</actions>
</idea-plugin>
